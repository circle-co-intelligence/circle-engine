# Self-host environment — copy to .env and fill in.

# Public hostname Caddy will serve TLS for (DNS A/AAAA must point here)
DOMAIN=circle.example.com

# TURN shared secret — generate: openssl rand -hex 32
TURN_SECRET=

# --- build-time frontend env (baked into the static bundle by selfhost.sh) ---

# mqtt signaling lane through our own broker (Caddy proxies wss → mosquitto)
VITE_CIC_LANES=mqtt
VITE_CIC_MQTT_BROKERS=wss://DOMAIN/mqtt

# TURN server — creds are minted time-limited by your ice endpoint, or use
# a fixed user for a private deployment:
# VITE_CIC_TURN='[{"urls":"turn:DOMAIN:3478","username":"u","credential":"p"}]'

# Optional: point AI lanes at a self-hosted gateway or the public one
# VITE_CIC_AI_ENDPOINT=https://cic-ai-gateway.terexmaps.workers.dev
# VITE_CIC_DSP_ENDPOINT=https://cic-dsp.terexmaps.workers.dev
# VITE_CIC_SPEECH_URL=wss://your-onprem-speechmatics/v2   (same RT protocol)
